---
/**
 * Carriages. A horizontal ride through the train, car by car.
 *
 * Vertical scroll pans a horizontal track. Between each car there is a
 * vestibule: the gangway door slides apart as you pass through it, so moving
 * between cities reads as walking down the train rather than as a slide
 * transition.
 *
 * Scroll is read once per frame inside a rAF, the same pattern ToriiTunnel
 * uses, so the two never fight over layout reads. Under reduced motion the
 * whole thing degrades to a plain vertical stack of cards.
 */
import { Image } from 'astro:assets';
import tokyo from '../assets/photos/tokyo-shibuya-night.jpg';
import osaka from '../assets/photos/osaka-street.jpg';
import kyoto from '../assets/photos/kyoto-torii-path.jpg';
import hama from '../assets/photos/hamamatsu-yamaha-entrance.jpg';
import hiro from '../assets/photos/hiroshima-atomic-dome-group.jpg';

const cars = [
  { n: 1, city: 'Tokyo', jp: '東京', dates: 'June 14 to 18', stay: 'The Knot Shinjuku',
    note: 'Five of us had never left the country. The first night we walked Shibuya until the trains stopped.', img: tokyo },
  { n: 2, city: 'Osaka', jp: '大阪', dates: 'June 18 to 21', stay: 'Villa Fontaine Grand Umeda',
    note: 'Street food costs less than the program fee assumes. This is where the budget started coming in under.', img: osaka },
  { n: 3, city: 'Kyoto', jp: '京都', dates: 'June 20', stay: 'A day trip out of Osaka',
    note: 'No overnight. The JR Pass made a whole extra city cost nothing.', img: kyoto },
  { n: 4, city: 'Hamamatsu', jp: '浜松', dates: 'June 21 to 23', stay: 'Okura Act City',
    note: 'The Yamaha plant at Kakegawa on the 22nd. The reason a mechanical engineering student was on this trip.', img: hama },
  { n: 5, city: 'Hiroshima', jp: '広島', dates: 'June 23 to 27', stay: 'The Knot Hiroshima',
    note: 'Mazda in the morning, the Peace Memorial in the afternoon. Both on the same day, on purpose.', img: hiro },
];
---

<section class="ride" data-ride aria-label="The route, car by car">
  <div class="ride__sticky">

    <div class="ride__cabin" aria-hidden="true">
      <div class="ride__ceiling"></div>
      <div class="ride__rack"></div>
      <div class="ride__floor"></div>
    </div>

    <div class="ride__track" data-track>
      {cars.map((c, i) => (
        <>
          {i > 0 && (
            <div class="vest" aria-hidden="true">
              <div class="vest__door vest__door--l"></div>
              <div class="vest__door vest__door--r"></div>
              <span class="vest__sign">{String(c.n).padStart(2, '0')}</span>
            </div>
          )}
          <article class="car">
            <div class="car__win">
              <Image src={c.img} alt={`${c.city}, seen on the trip`} widths={[520, 900]} sizes="42vw" loading={i < 2 ? 'eager' : 'lazy'} />
              <span class="car__blur"></span>
            </div>
            <div class="car__body">
              <p class="car__no">CAR {String(c.n).padStart(2, '0')}</p>
              <h3 class="car__city">{c.city}<span>{c.jp}</span></h3>
              <p class="car__meta">{c.dates}<br />{c.stay}</p>
              <p class="car__note">{c.note}</p>
            </div>
          </article>
        </>
      ))}
    </div>

    <div class="ride__hud" aria-hidden="true">
      <span class="ride__kmh"><b data-kmh>0</b> km/h</span>
      <span class="ride__line">
        {cars.map((c) => <i data-dot={c.n}></i>)}
      </span>
    </div>
  </div>
</section>

<style>
  .ride { position: relative; height: 480vh; background: #05060b; }
  .ride__sticky { position: sticky; top: 0; height: 100dvh; overflow: hidden; }

  /* cabin shell: ceiling, luggage rack, floor. Sells the interior without art. */
  .ride__cabin { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .ride__ceiling { position: absolute; inset: 0 0 auto; height: 22%;
    background: linear-gradient(to bottom, #11141d, #0a0c13 70%, transparent); }
  .ride__rack { position: absolute; left: 0; right: 0; top: 21%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--hairline-2, #39404f) 12%, var(--hairline-2, #39404f) 88%, transparent);
    box-shadow: 0 10px 26px -18px #000; }
  .ride__floor { position: absolute; inset: auto 0 0; height: 26%;
    background: linear-gradient(to top, #0b0d14, transparent); }

  .ride__track { position: absolute; top: 0; bottom: 0; left: 0;
    display: flex; align-items: center; gap: 0;
    will-change: transform; z-index: 1; }

  /* ---------- a car ---------- */
  .car { flex: 0 0 72vw; max-width: 1080px; height: 100%;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center; gap: clamp(20px, 3vw, 54px);
    padding: 0 clamp(20px, 4vw, 64px); }

  .car__win { position: relative; aspect-ratio: 4 / 3; border-radius: 14px;
    overflow: hidden; background: #0a0c12;
    border: 1px solid #2b3142;
    box-shadow: inset 0 0 0 6px #0d1017, inset 0 0 40px -14px #000, 0 30px 70px -40px #000; }
  .car__win :global(img) { width: 100%; height: 100%; object-fit: cover;
    filter: saturate(.94) contrast(1.02); }
  /* glass, not blur: a faint reflection sheen across the window */
  .car__blur { position: absolute; inset: 0; pointer-events: none;
    opacity: calc(.18 + var(--vel, 0) * .22);
    background: linear-gradient(104deg, transparent 38%, rgb(255 255 255 / .07) 46%, transparent 54%); }

  .car__no { font: 700 11px/1 var(--mono); letter-spacing: .28em;
    color: var(--torii); margin: 0 0 14px; }
  .car__city { font: 700 clamp(2rem, 4.4vw, 3.6rem)/1.02 var(--serif);
    margin: 0 0 14px; letter-spacing: -.015em; }
  .car__city span { display: block; font-size: .42em; color: var(--ink-3);
    letter-spacing: .12em; margin-top: 8px; }
  .car__meta { font: 400 13px/1.6 var(--mono); letter-spacing: .05em;
    color: var(--ink-3); margin: 0 0 18px; }
  .car__note { color: var(--ink-2); margin: 0; max-width: 40ch; }

  /* ---------- vestibule between cars ---------- */
  .vest { flex: 0 0 26vw; height: 100%; position: relative;
    display: grid; place-items: center; }
  .vest::before { content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, #05060b, #0c0f17 22%, #0c0f17 78%, #05060b);
    border-left: 1px solid #1c2130; border-right: 1px solid #1c2130; }
  .vest__door { position: absolute; top: 10%; bottom: 10%; width: 26%;
    background:
      /* warning stripe along the leading edge */
      linear-gradient(180deg, transparent 0 6%, #d8a13a 6% 7.2%, transparent 7.2%),
      linear-gradient(180deg, #1b2030 0 46%, #141824 46%);
    border: 1px solid #333b4d;
    box-shadow: inset 0 1px 0 #3d465c, 0 22px 50px -30px #000; }
  .vest__door::after { content: ""; position: absolute; left: 14%; right: 14%;
    top: 12%; height: 30%; border-radius: 3px;
    background: linear-gradient(180deg, #0c1018, #070a10);
    border: 1px solid #39425a;
    box-shadow: inset 0 0 22px -10px #6f8ab5; }
  .vest__door--l { left: 24%; border-radius: 5px 0 0 5px;
    transform: translateX(calc(var(--open, 0) * -118%)); }
  .vest__door--r { right: 24%; border-radius: 0 5px 5px 0;
    transform: translateX(calc(var(--open, 0) * 118%)); }
  /* the gangway you see once the doors part */
  .vest__sign { position: relative; z-index: 2;
    font: 800 clamp(2.4rem, 6vw, 5rem)/1 var(--mono);
    color: #39425a; letter-spacing: -.02em;
    opacity: calc(.25 + var(--open, 0) * .75);
    text-shadow: 0 0 40px rgb(111 138 181 / calc(var(--open, 0) * .45)); }

  /* ---------- hud ---------- */
  .ride__hud { position: absolute; left: 0; right: 0; bottom: clamp(18px, 4vh, 40px);
    z-index: 3; display: flex; align-items: center; justify-content: center;
    gap: 22px; pointer-events: none; }
  .ride__kmh { font: 400 12px/1 var(--mono); letter-spacing: .18em; color: var(--ink-3); }
  .ride__kmh b { font-weight: 800; color: var(--ink); font-size: 15px; }
  .ride__line { display: flex; gap: 7px; }
  .ride__line i { width: 22px; height: 2px; background: #262b38; display: block;
    transition: background .3s; }
  .ride__line i[data-on] { background: var(--torii); }

  @media (max-width: 62rem) {
    .car { flex-basis: 86vw; grid-template-columns: 1fr; gap: 18px;
      align-content: center; }
    .car__win { aspect-ratio: 16 / 10; }
    .vest { flex-basis: 34vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ride { height: auto; }
    .ride__sticky { position: static; height: auto; overflow: visible; }
    .ride__track { position: static; flex-direction: column; transform: none !important; }
    .car { flex-basis: auto; height: auto; padding: 40px clamp(20px, 5vw, 60px);
      max-width: 820px; margin-inline: auto; }
    .vest { display: none; }
    .ride__cabin, .ride__hud { display: none; }
    .car__win :global(img) { filter: saturate(.86); }
  }
</style>

<script>
  let dispose: (() => void) | undefined;

  function setup() {
    dispose?.();
    const ride = document.querySelector<HTMLElement>('[data-ride]');
    const track = document.querySelector<HTMLElement>('[data-track]');
    if (!ride || !track) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return;

    const kmh = ride.querySelector<HTMLElement>('[data-kmh]');
    const dots = [...ride.querySelectorAll<HTMLElement>('[data-dot]')];
    const vests = [...ride.querySelectorAll<HTMLElement>('.vest')];
    const cars = [...ride.querySelectorAll<HTMLElement>('.car')];

    let frame = 0;
    let lastX = 0;
    let lastT = performance.now();

    const paint = () => {
      frame = 0;
      const rect = ride.getBoundingClientRect();
      const travel = Math.max(1, ride.offsetHeight - innerHeight);
      const p = Math.min(1, Math.max(0, -rect.top / travel));

      const distance = Math.max(0, track.scrollWidth - innerWidth);
      const x = p * distance;
      track.style.transform = `translate3d(${-x}px,0,0)`;

      // velocity, normalised, drives window blur and the speed readout
      const now = performance.now();
      const dt = Math.max(16, now - lastT);
      const v = Math.min(1, (Math.abs(x - lastX) / dt) * 7);
      lastX = x; lastT = now;
      ride.style.setProperty('--vel', v.toFixed(3));
      if (kmh) kmh.textContent = String(Math.round(v * 320));

      // each vestibule opens as it crosses the middle of the viewport
      for (const vest of vests) {
        const r = vest.getBoundingClientRect();
        const centre = r.left + r.width / 2;
        const d = Math.abs(centre - innerWidth / 2) / (innerWidth * 0.55);
        vest.style.setProperty('--open', (1 - Math.min(1, d)).toFixed(3));
      }

      // which car is in front of you
      let active = 0;
      cars.forEach((car, i) => {
        const r = car.getBoundingClientRect();
        if (r.left < innerWidth * 0.55 && r.right > innerWidth * 0.45) active = i;
      });
      dots.forEach((d, i) => {
        if (i <= active) d.setAttribute('data-on', ''); else d.removeAttribute('data-on');
      });
    };

    const onScroll = () => { if (!frame) frame = requestAnimationFrame(paint); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    paint();

    dispose = () => {
      removeEventListener('scroll', onScroll);
      removeEventListener('resize', onScroll);
      if (frame) cancelAnimationFrame(frame);
    };
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
