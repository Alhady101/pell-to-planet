---
/**
 * Arcade. The funding stack shown as a cabinet high-score board, with a gap
 * bar underneath that does the actual work: cost, what the awards covered,
 * and what was still left to pay.
 *
 * Every figure comes from the data layer, so this cannot drift out of step
 * with /my-numbers/. In particular the term-aid share is applied here the
 * same way it is applied there: Pell and the Senior Sprint award pay against
 * a whole term, so only 3 of 13 credits' worth belongs to this trip.
 *
 * Sprites are original 16x16 pixel art drawn as SVG rects. No third-party
 * characters: the recognisable arcade mascots are active trademarks and this
 * page carries the author's name on a Department of State project.
 */
import { funding, totals, japanShareOfTerm, tripSpecificFunding } from '../data/facts';

const fmt = (v: number) => '$' + Math.round(v).toLocaleString('en-US');

const rows = funding
  .filter((f) => f.amountUSD !== null)
  .map((f) => {
    const isTrip = tripSpecificFunding.includes(f.id);
    return {
      label: f.label.replace(/\s*\(.*$/, ''),
      amount: f.amountUSD as number,
      isTrip,
      counted: isTrip ? (f.amountUSD as number) : (f.amountUSD as number) * japanShareOfTerm,
    };
  })
  .sort((a, b) => b.counted - a.counted);

const cost = totals.costsKnown;
const covered = totals.fundingAttributable;
const gap = totals.outOfPocket;
const max = Math.max(cost, covered + Math.max(0, gap));
const pct = (v: number) => ((v / max) * 100).toFixed(2);

/* ---- original sprites: rows of palette keys, '.' is transparent ---- */
const PAL: Record<string, string> = {
  r: '#ff5f3f', d: '#b03a24', k: '#1a1f2b', w: '#f4f2ec',
  y: '#e8c07a', c: '#38e8ff', g: '#3ddca0', s: '#7e7a72',
};
const SPRITES: Record<string, string[]> = {
  // a torii gate
  torii: [
    '.rrrrrrrrrrrrrr.',
    'rrrrrrrrrrrrrrrr',
    '..dd........dd..',
    '.rrrrrrrrrrrrrr.',
    '..dd........dd..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '..rr........rr..',
    '.dddd......dddd.',
    '.kkkk......kkkk.',
  ],
  // a shinkansen nose
  train: [
    '................',
    '.......ccccc....',
    '.....cccwwwcc...',
    '...ccwwwwwwwcc..',
    '..cwwwwwwwwwwwc.',
    '.cwwkkwwwwkkwwwc',
    'cwwwkkwwwwkkwwww',
    'cwwwwwwwwwwwwwww',
    'cwwwwwwwwwwwwwww',
    'cccccccccccccccc',
    '.kk..kk....kk.kk',
    '................',
    '................',
    '................',
    '................',
    '................',
  ],
  // a coin
  coin: [
    '.....yyyyyy.....',
    '...yyyyyyyyyy...',
    '..yyyywwwwyyyy..',
    '.yyyww....wwyyy.',
    '.yyyw..yy..wyyy.',
    'yyyw..yyyy..wyyy',
    'yyyw..yyyy..wyyy',
    'yyyw..yyyy..wyyy',
    'yyyw..yyyy..wyyy',
    'yyyw..yyyy..wyyy',
    'yyyw..yyyy..wyyy',
    '.yyyw..yy..wyyy.',
    '.yyyww....wwyyy.',
    '..yyyywwwwyyyy..',
    '...yyyyyyyyyy...',
    '.....yyyyyy.....',
  ],
  // a student with a pack
  student: [
    '.....kkkkkk.....',
    '....kkkkkkkk....',
    '...kkyyyyyykk...',
    '...kyywwyywyk...',
    '...kyywwyywyk...',
    '...kyyyyyyyyk...',
    '...kkyywwyykk...',
    '....kkyyyykk....',
    '..ggggkkkkgggg..',
    '.gggggkkkkggggg.',
    'sggggggkkgggggg.',
    'sggggggkkgggggg.',
    's.gggggkkggggg..',
    '..kkkk....kkkk..',
    '..kkkk....kkkk..',
    '..kkk......kkk..',
  ],
};

function cells(name: string) {
  const g = SPRITES[name];
  const out: { x: number; y: number; f: string }[] = [];
  g.forEach((row, y) => [...row].forEach((ch, x) => {
    if (ch !== '.') out.push({ x, y, f: PAL[ch] });
  }));
  return out;
}
const spriteNames = ['student', 'coin', 'train', 'torii'];
---

<section class="arc" aria-labelledby="arc-title">
  <div class="arc__wrap">

    <div class="arc__sprites" aria-hidden="true">
      {spriteNames.map((n, i) => (
        <svg class="arc__sprite" viewBox="0 0 16 16" width="64" height="64" style={`--i:${i}`}>
          {cells(n).map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill={c.f} />)}
        </svg>
      ))}
    </div>

    <div class="cab">
      <h2 class="cab__title" id="arc-title">AWARD SELECT<span class="cab__cur">_</span></h2>

      <ol class="cab__list">
        {rows.map((r, i) => (
          <li class="cab__row">
            <span class="cab__rk">{String(i + 1).padStart(2, '0')}</span>
            <span class="cab__nm">{r.label}</span>
            <span class="cab__amt">{fmt(r.amount)}</span>
            <span class={`cab__tag ${r.isTrip ? 'is-trip' : 'is-term'}`}>
              {r.isTrip ? 'ALL COUNTS' : '3/13 COUNTS'}
            </span>
          </li>
        ))}
      </ol>

      <p class="cab__note">
        Trip awards count in full. Term aid pays against all thirteen credits of the
        term, so only the three-credit share belongs to this trip. That single rule is
        what most budget guides get wrong.
      </p>
    </div>

    <figure class="gap">
      <figcaption class="gap__cap">What it cost, what was covered, what was left</figcaption>

      <div class="gap__row">
        <span class="gap__lab">Cost of going</span>
        <div class="gap__track"><span class="gap__fill is-cost" style={`width:${pct(cost)}%`}></span></div>
        <span class="gap__val">{fmt(cost)}</span>
      </div>

      <div class="gap__row">
        <span class="gap__lab">Covered by awards</span>
        <div class="gap__track">
          <span class="gap__fill is-cov" style={`width:${pct(covered)}%`}></span>
          <span class="gap__fill is-gap" style={`width:${pct(Math.max(0, gap))}%;left:${pct(covered)}%`}></span>
        </div>
        <span class="gap__val">{fmt(covered)}</span>
      </div>

      <p class="gap__verdict">
        <b>{fmt(Math.max(0, gap))}</b> still came out of pocket. Four awards, and there
        was still a gap. Knowing the size of that gap early is the difference between
        planning for it and being surprised by it.
      </p>

      <table class="gap__table">
        <caption class="vh">The same figures as a table</caption>
        <tbody>
          <tr><th scope="row">Cost of going</th><td>{fmt(cost)}</td></tr>
          <tr><th scope="row">Covered by awards</th><td>{fmt(covered)}</td></tr>
          <tr><th scope="row">Out of pocket</th><td>{fmt(Math.max(0, gap))}</td></tr>
        </tbody>
      </table>
    </figure>

  </div>
</section>

<style>
  .arc { position: relative; padding: clamp(60px, 10vh, 120px) 0; background: #070910; overflow: hidden; }
  .arc::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / .30) 0 1px, transparent 1px 3px);
  }
  .arc__wrap { position: relative; z-index: 1; max-width: 900px; margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 48px); }

  .arc__sprites { display: flex; gap: clamp(16px, 4vw, 44px); justify-content: center;
    margin-bottom: clamp(26px, 4vh, 46px); }
  .arc__sprite { image-rendering: pixelated; shape-rendering: crispEdges;
    animation: hop 2.4s steps(2) infinite; animation-delay: calc(var(--i) * .3s);
    filter: drop-shadow(0 0 18px rgb(56 232 255 / .18)); }
  @keyframes hop { 0%, 40%, 100% { transform: translateY(0) } 50%, 90% { transform: translateY(-5px) } }

  .cab { border: 2px solid var(--s2, #3987e5); border-radius: 6px; background: rgb(5 7 14 / .92);
    padding: clamp(20px, 3.4vw, 34px);
    box-shadow: 0 0 64px -20px var(--s2, #3987e5), inset 0 0 40px -24px var(--s2, #3987e5); }
  .cab__title { font: 800 clamp(.95rem, 2.2vw, 1.35rem)/1 var(--mono);
    letter-spacing: .24em; color: var(--s2, #3987e5); margin: 0 0 22px; text-align: center; }
  .cab__cur { animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: .2 } }

  .cab__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cab__row { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr) auto auto;
    gap: 12px; align-items: baseline; font-family: var(--mono);
    font-size: clamp(.74rem, 1.55vw, .95rem); padding: 7px 8px; border-radius: 2px; }
  .cab__row:nth-child(odd) { background: rgb(57 135 229 / .06); }
  .cab__rk { color: var(--gold, #e8c07a); font-weight: 800; }
  .cab__nm { color: var(--ink-2); letter-spacing: .05em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cab__amt { color: var(--ink); font-weight: 800; }
  .cab__tag { font-size: .68em; letter-spacing: .12em; padding: 3px 7px; border-radius: 2px; }
  .cab__tag.is-trip { color: #0a1a12; background: var(--jade, #3ddca0); }
  .cab__tag.is-term { color: var(--ink-3); border: 1px solid var(--hairline-2, #39404f); }
  .cab__note { color: var(--ink-3); font-size: 13.5px; margin: 20px 0 0;
    padding-top: 16px; border-top: 1px solid rgb(57 135 229 / .28); }

  /* ---------- the gap bar: the part that actually helps ---------- */
  .gap { margin: clamp(34px, 5vh, 56px) 0 0; }
  .gap__cap { font: 400 11px/1 var(--mono); letter-spacing: .22em; text-transform: uppercase;
    color: var(--ink-3); margin-bottom: 22px; }
  .gap__row { display: grid; grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr) auto;
    gap: 14px; align-items: center; margin-bottom: 14px; }
  .gap__lab { font-size: 13.5px; color: var(--ink-2); }
  .gap__track { position: relative; height: 22px; background: var(--surface-2, #161923);
    border-radius: 2px; overflow: hidden; }
  .gap__fill { position: absolute; top: 0; bottom: 0; left: 0; border-radius: 2px; }
  .gap__fill.is-cost { background: var(--s3, #c98500); }
  .gap__fill.is-cov { background: var(--s4, #199e70); }
  /* the gap gets a texture as well as a colour, so it never reads by hue alone */
  .gap__fill.is-gap { background:
      repeating-linear-gradient(135deg, var(--torii, #ff5f3f) 0 5px, #8c2e1c 5px 10px); }
  .gap__val { font: 800 14.5px/1 var(--mono); color: var(--ink); }
  .gap__verdict { margin: 22px 0 0; color: var(--ink-2); max-width: 58ch; }
  .gap__verdict b { color: var(--torii, #ff5f3f); font-family: var(--mono);
    font-size: 1.32em; font-weight: 800; }

  .gap__table { width: 100%; margin-top: 26px; border-collapse: collapse;
    font-family: var(--mono); font-size: 13px; }
  .gap__table th, .gap__table td { text-align: left; padding: 9px 0;
    border-bottom: 1px solid var(--hairline, #262b38); font-weight: 400; }
  .gap__table th { color: var(--ink-3); }
  .gap__table td { color: var(--ink); text-align: right; font-weight: 800; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  @media (max-width: 40rem) {
    .cab__row { grid-template-columns: 1.8rem minmax(0, 1fr) auto; }
    .cab__tag { grid-column: 2 / -1; justify-self: start; }
    .gap__row { grid-template-columns: 1fr; gap: 6px; }
    .gap__val { justify-self: end; }
  }
  @media (prefers-reduced-motion: reduce) {
    .arc__sprite, .cab__cur { animation: none; }
  }
</style>
