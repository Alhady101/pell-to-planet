---
/**
 * Two horizontal stacked bars on one scale: what the trip cost vs. what covered it.
 * Pure SVG, no JS. Every segment is also in the table view below the chart
 * (the WCAG twin), so color never carries meaning alone.
 */
interface Segment { label: string; value: number; slot: 1 | 2 | 3 | 4 | 'muted' }
interface Bar { title: string; segments: Segment[]; caption?: string }
interface Props { bars: Bar[]; id: string }
const { bars, id } = Astro.props;

const max = Math.max(...bars.map((b) => b.segments.reduce((a, s) => a + s.value, 0)));
const W = 720, PAD_R = 90, barH = 22, gap = 2, rowH = 78, padTop = 8;
const H = padTop + bars.length * rowH;
const x = (v: number) => (v / max) * W;
const fmt = (v: number) => '$' + Math.round(v).toLocaleString('en-US');
const color = (slot: Segment['slot']) => (slot === 'muted' ? 'var(--s-muted)' : `var(--s${slot})`);
// ticks: clean thousands
const step = max > 6000 ? 2000 : 1000;
const ticks: number[] = [];
for (let t = 0; t <= max; t += step) ticks.push(t);
---
<figure class="stack" aria-labelledby={`${id}-title`}>
  <svg viewBox={`0 0 ${W + PAD_R} ${H + 24}`} role="img" aria-describedby={`${id}-table`} width="100%">
    <title id={`${id}-title`}>Cost of the trip compared with the funding that covered it</title>
    {ticks.map((t) => (
      <g>
        <line x1={x(t)} x2={x(t)} y1={padTop} y2={H} stroke="var(--rule)" stroke-width="1" />
        <text x={x(t)} y={H + 18} font-size="11" fill="var(--ink-3)" text-anchor={t === 0 ? 'start' : 'middle'} font-family="var(--sans)">{fmt(t)}</text>
      </g>
    ))}
    {bars.map((bar, bi) => {
      const y = padTop + bi * rowH + 20;
      let cx = 0;
      const total = bar.segments.reduce((a, s) => a + s.value, 0);
      return (
        <g>
          <text x="0" y={y - 7} font-size="12" font-weight="600" fill="var(--ink-2)" font-family="var(--sans)" letter-spacing="0.04em">{bar.title.toUpperCase()}</text>
          {bar.segments.map((s, si) => {
            const w = x(s.value);
            const el = (
              <rect x={cx + (si === 0 ? 0 : gap)} y={y} width={Math.max(0, w - (si === 0 ? 0 : gap))} height={barH}
                fill={color(s.slot)} rx={si === bar.segments.length - 1 ? 4 : 0}>
                <title>{s.label}: {fmt(s.value)}</title>
              </rect>
            );
            cx += w;
            return el;
          })}
          <text x={x(total) + 8} y={y + barH / 2 + 4} font-size="13" font-weight="600" fill="var(--ink)" font-family="var(--sans)" style="font-variant-numeric: tabular-nums">{fmt(total)}</text>
        </g>
      );
    })}
  </svg>

  <div class="legends">
    {bars.map((bar) => (
      <ul class="legend" aria-hidden="true">
        <li class="legend__title">{bar.title}</li>
        {bar.segments.map((s) => (
          <li><span class="swatch" style={`background:${color(s.slot)}`}></span>{s.label}</li>
        ))}
      </ul>
    ))}
  </div>

  <details class="table-view">
    <summary>Table view</summary>
    <table id={`${id}-table`}>
      <thead><tr><th>Bar</th><th>Segment</th><th class="num">USD</th></tr></thead>
      <tbody>
        {bars.flatMap((b) => b.segments.map((s) => (
          <tr><td>{b.title}</td><td>{s.label}</td><td class="num">{fmt(s.value)}</td></tr>
        )))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .stack { margin: 1.5rem 0; }
  .legends { display: grid; gap: 0.35rem; margin-top: 0.25rem; }
  .legend__title { font-weight: 600; color: var(--ink); }
  .legend { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-size: 0.85rem; color: var(--ink-2); }
  .legend li { display: inline-flex; align-items: center; gap: 0.45em; }
  .swatch { width: 0.8em; height: 0.8em; border-radius: 2px; display: inline-block; }
  .table-view { margin-top: 0.75rem; font-size: 0.9rem; }
  .table-view summary { cursor: pointer; color: var(--ink-2); }
  rect:hover { opacity: 0.85; }
</style>
