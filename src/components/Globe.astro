---
/**
 * Hero globe. The canvas is decorative (the flight it draws is stated in the
 * adjacent copy), so it is aria-hidden and given a text alternative below.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={`globe ${cls}`}>
  <canvas data-globe aria-hidden="true"></canvas>
  <p class="visually-hidden">
    An illustrated globe. A line traces the flight from Detroit, Michigan to Tokyo, Japan.
    Smaller markers show the countries the author is working toward next, which are
    listed in full further down this page.
  </p>
  <p class="globe__hint" aria-hidden="true"><span>drag to spin</span></p>
</div>

<style>
  .globe { position: relative; width: 100%; aspect-ratio: 1; max-width: 42rem; margin-inline: auto; }
  .globe canvas { width: 100%; height: 100%; }
  .globe__hint {
    position: absolute; left: 50%; bottom: -0.25rem; translate: -50% 0; margin: 0;
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink-3); opacity: 0; transition: opacity 0.5s 1.2s;
  }
  .globe:hover .globe__hint { opacity: 0.8; transition-delay: 0s; }
  @media (hover: none) { .globe__hint { opacity: 0.7; } .globe__hint span::before { content: 'swipe to spin'; } .globe__hint span { font-size: 0; } .globe__hint span::before { font-size: 0.62rem; } }
</style>

<script>
  import { initGlobe } from '../scripts/globe';

  let teardown: (() => void) | null = null;
  function mount() {
    teardown?.();
    teardown = null;
    const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
    if (canvas) teardown = initGlobe(canvas);
  }
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => { teardown?.(); teardown = null; });
</script>
