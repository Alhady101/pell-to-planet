---
import { Image } from 'astro:assets';
import torii from '../assets/photos/torii-higgsfield-frontal.png';
import shrine from '../assets/photos/torii-shrine-reveal.png';
---
<div class="torii" aria-hidden="true" data-torii>
  <div class="torii__plate">
    <Image src={torii} alt="" widths={[900, 1400, 1672]} sizes="100vw" loading="eager" />
    <Image class="torii__shrine" src={shrine} alt="" widths={[900, 1400, 1672]} sizes="100vw" loading="eager" />
  </div>
  <div class="torii__stars"></div>
  <div class="torii__mist"></div>
  <div class="torii__grade"></div>
  <p class="torii__credit">Atmospheric artwork · Higgsfield original, AI-assisted adaptation</p>
</div>
<style>
  .torii { position: absolute; inset: 0; overflow: hidden; pointer-events: none; background: #071025; }
  .torii__plate { position: absolute; inset: 0; transform-origin: 50% 44%; transform: scale(var(--dolly,1)); }
  .torii__plate img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }
  .torii__plate .torii__shrine { position: absolute; inset: 0; opacity: var(--shrine-reveal,0); filter: blur(calc((1 - var(--shrine-reveal,0)) * 8px)); }
  @media (max-width: 40rem) {
    .torii__plate img { position: absolute; width: 160vw; max-width: none; left: 50%; transform: translateX(-50%); object-fit: contain; }
  }
  .torii__grade { position: absolute; inset: 0; background: linear-gradient(180deg,#07102522 0%,transparent 35%,#07102555 55%,#071025ed 100%); }
  .torii__stars { position: absolute; inset: 0 0 42%; background-image: radial-gradient(circle,#e1ebff 1px,transparent 2px),radial-gradient(circle,#ffdca5 1px,transparent 1.8px); background-size: 173px 127px,233px 197px; background-position: 23px 44px,104px 70px; opacity: .35; animation: shimmer 6s ease-in-out infinite alternate; }
  .torii__mist { position: absolute; inset: 45% -20% 0; opacity: .35; background: radial-gradient(ellipse at 28% 35%,#cbd8f43d,transparent 55%),radial-gradient(ellipse at 75% 55%,#cfbddd44,transparent 45%); animation: mist 12s ease-in-out infinite alternate; }
  .torii__mist { opacity: calc(.55 - var(--shrine-reveal,0) * .3); }
  .torii__credit { position: absolute; bottom: .65rem; right: 1rem; left: 1rem; text-align: right; font: .62rem var(--sans); color: #b9c7de; margin: 0; z-index: 3; }
  @keyframes shimmer { to { opacity: .75; transform: translateY(5px); } }
  @keyframes mist { to { transform: translate3d(6%,-3%,0) scale(1.06); opacity: .6; } }
  @media (prefers-reduced-motion: reduce) { .torii__plate { transform: none; } .torii__stars,.torii__mist { animation: none; } }
</style>
<script>
  let dispose: (() => void) | undefined;
  function setup() {
    dispose?.();
    const el = document.querySelector<HTMLElement>('[data-torii]');
    const section = el?.closest<HTMLElement>('.torii-section');
    if (!el || !section) return;
    const copy = section.querySelector<HTMLElement>('.torii-section__inner');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const paint = () => {
      frame = 0;
      const rect = section.getBoundingClientRect();
      const travel = Math.max(1, section.offsetHeight - innerHeight);
      const progress = Math.max(0,Math.min(1,-rect.top / travel));
      el.style.setProperty('--dolly', String(reduced.matches ? 1 : 1 + progress * .6));
      const reveal = reduced.matches ? 1 : Math.max(0,Math.min(1,(progress - .22) / .64));
      el.style.setProperty('--shrine-reveal', String(reveal * reveal * (3 - 2 * reveal)));
      if (copy) {
        const fade = reduced.matches ? 1 : 1 - Math.max(0,Math.min(1,(progress - .47) / .35));
        copy.style.opacity = String(fade);
        copy.inert = fade < .02;
      }
    };
    const update = () => { if (!frame) frame = requestAnimationFrame(paint); };
    addEventListener('scroll',update,{passive:true});
    addEventListener('resize',update);
    reduced.addEventListener('change',paint);
    paint();
    dispose = () => { cancelAnimationFrame(frame); removeEventListener('scroll',update); removeEventListener('resize',update); reduced.removeEventListener('change',paint); };
  }
  setup();
  document.addEventListener('astro:page-load',setup);
  document.addEventListener('astro:before-swap',()=>dispose?.());
</script>
