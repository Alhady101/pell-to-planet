---
/**
 * The senbon torii corridor of Fushimi Inari, which the group walked up on
 * June 20. Rendered as real 3D geometry on a canvas — see src/scripts/torii.ts
 * for the model and the renderer.
 *
 * Decorative, so the canvas is aria-hidden and never focusable. Under
 * prefers-reduced-motion the camera stops walking and it renders one still
 * frame of the corridor.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={`torii-tunnel ${cls}`} aria-hidden="true">
  <canvas data-torii></canvas>
</div>

<style>
  .torii-tunnel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fades the corridor into the section rather than cutting it off. */
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 86%, transparent);
  }
  .torii-tunnel canvas { width: 100%; height: 100%; display: block; }
  :root[data-theme='light'] .torii-tunnel { opacity: 0.55; }
</style>

<script>
  import { initTorii } from '../scripts/torii';

  const mounted = new WeakMap<HTMLCanvasElement, () => void>();

  function mount() {
    document.querySelectorAll<HTMLCanvasElement>('[data-torii]').forEach((c) => {
      if (mounted.has(c)) return;
      mounted.set(c, initTorii(c));
    });
  }
  function unmountAll() {
    document.querySelectorAll<HTMLCanvasElement>('[data-torii]').forEach((c) => {
      const teardown = mounted.get(c);
      if (teardown) { teardown(); mounted.delete(c); }
    });
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmountAll);
</script>
