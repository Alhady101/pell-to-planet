---
import Base from '../layouts/Base.astro';
import Globe from '../components/Globe.astro';
import Petals from '../components/Petals.astro';
import ToriiTunnel from '../components/ToriiTunnel.astro';
import Figure from '../components/Figure.astro';
import Money from '../components/Money.astro';
import { totals, program } from '../data/facts';
import { DESTINATIONS, REGIONS } from '../data/destinations';

import pKyotoGroup from '../assets/photos/kyoto-fushimi-group-selfie.jpg';
import pYamahaGroup from '../assets/photos/yamaha-kakegawa-group-flag.jpg';
import pOsakaUni from '../assets/photos/osaka-university-group-flag.jpg';
import pMazda from '../assets/photos/hiroshima-mazda-787b-selfie.jpg';
import pTeppan from '../assets/photos/hamamatsu-teppanyaki-table.jpg';
import pRain from '../assets/photos/hiroshima-rain-classmates.jpg';

const base = import.meta.env.BASE_URL;

const chapters = [
  { n: '01', href: 'the-trip/', title: 'The trip', dek: 'Fourteen days, five cities, four factory floors — and the evenings in between. What travelling with your school and a group of classmates is actually like.' },
  { n: '02', href: 'my-numbers/', title: 'My numbers', dek: 'Every dollar the program cost me, every award that covered it, and the dates the money actually moved. Nothing rounded up to look good.' },
  { n: '03', href: 'funding/', title: 'Funding', dek: 'Where the money comes from: federal aid, campus awards, national scholarships. What each one requires and who to ask.' },
  { n: '04', href: 'gilman/', title: 'Gilman', dek: 'The scholarship that made mine possible. Eligibility, the four essays, the deadlines, and how I approached my application.' },
  { n: '05', href: 'tools/', title: 'Tools', dek: 'A gap calculator and a backward-planning timeline you can fill in and take to your advisor.' },
];

const stats = [
  { value: '14', label: 'Days in Japan', sub: 'June 13–27, 2026' },
  { value: '4', label: 'Factory floors', sub: 'Yamaha, KEYLEX, DELTA, Mazda' },
  { value: '10', label: 'Students on the trip', sub: 'One faculty leader' },
  { value: '3', label: 'Credits earned', sub: 'GSC 4991, toward my degree' },
];
---
<Base
  title="Pell to Planet"
  description="A Wayne State student's guide to funding short-term study abroad. Real costs, real awards, and what two weeks in Japan actually bought me — written by a Pell Grant recipient and Gilman Scholar."
  transparentHeader
>
  {/* ================= HERO ================= */}
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <Petals count={14} />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__kicker"><span class="dot" aria-hidden="true"></span>Detroit <span aria-hidden="true">→</span><span class="visually-hidden">to</span> Tokyo · June 2026</p>
        <h1>
          <span class="l1">Study abroad</span>
          <span class="l2">on a <em>Pell</em> budget.</span>
        </h1>
        <p class="lede">
          I'm a mechanical engineering student from Detroit. I assumed a program like this
          was for other people's budgets. This is the whole map of how I paid for mine —
          the real numbers, the awards, and the parts nobody puts on the brochure.
        </p>
        <div class="cta-row">
          <a class="button" href={`${base}my-numbers/`}>See every dollar<span class="arrow" aria-hidden="true">→</span></a>
          <a class="button button--ghost" href={`${base}the-trip/`}>What it was like</a>
        </div>
        <p class="hero__byline">
          Gotibeh Alhady · Gilman Scholar · Wayne State University
        </p>
      </div>

      <div class="hero__globe">
        <Globe />
      </div>
    </div>

    <a class="scroll-cue" href="#start" aria-label="Scroll to the introduction">
      <span aria-hidden="true">scroll</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  {/* ================= THE BARRIER ================= */}
  <section class="section section--ruled" id="start">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow" data-reveal>Why this exists</p>
        <h2 data-reveal>The price tag is the first thing that stops you.</h2>
      </div>
      <div data-reveal>
        <p>
          When I found the Japan program in my department, I did what I think most
          Pell-eligible students do. I looked at the program fee, added a plane ticket
          in my head, decided it was not realistic, and closed the tab.
        </p>
        <p>
          What changed was learning that the sticker price is not one number — it is a
          stack of them, and each layer has its own way of being paid. Some of it is
          covered before you ever see a bill. Some of it is money you have to go and ask
          for. And some of it is yours, which is worth knowing early rather than in April.
        </p>
        <p>
          I went. I came back with three credits, four factory floors in my notes, and a
          much clearer sense of how the money worked. This site is that, written down, for
          the next student in my position.
        </p>
        <div class="callout">
          <p>
            <strong>Everything here carries a source.</strong> Costs come from my own
            statements and receipts, awards from my award letters, and rules from the
            official pages, each with the date I checked it. Where I do not know a number,
            it says so instead of guessing.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ================= STAT STRIP ================= */}
  <section class="section section--tight section--raised">
    <div class="wrap">
      <div class="stat-strip">
        <div class="stat stat--lead" data-reveal>
          <span class="stat__label">The award that opened the door</span>
          <span class="stat__value stat__value--hero"><Money value={2500} /></span>
          <span class="stat__sub">Benjamin A. Gilman International Scholarship, U.S. Department of State</span>
        </div>
        <div class="stat-strip__rest">
          {stats.map((s, i) => (
            <div class="stat" data-reveal data-reveal-delay={i * 70}>
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
              <span class="stat__sub">{s.sub}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="small stat-strip__note" data-reveal>
        The trip cost roughly <Money value={Math.round(totals.costsKnown / 100) * 100} /> all in.
        Awards and aid covered most of it. <a href={`${base}my-numbers/`}>The full breakdown →</a>
      </p>
    </div>
  </section>

  {/* ================= TORII MOMENT ================= */}
  <section class="torii-section">
    <ToriiTunnel />
    <div class="wrap torii-section__inner">
      <p class="eyebrow centered" data-reveal>June 20 · Kyoto</p>
      <h2 class="torii-section__h" data-reveal>
        You do not get this<br />from a slide deck.
      </h2>
      <p class="lede centered" data-reveal>
        Our class walked up through the gates at Fushimi Inari in the rain. Two days
        earlier we were in a university classroom in Osaka arguing about stakeholders
        with Japanese students. Two days later we were watching pianos being built.
      </p>
    </div>
  </section>

  {/* ================= WHAT IT LOOKS LIKE ================= */}
  <section class="section">
    <div class="wrap">
      <div class="mosaic-head">
        <div>
          <p class="eyebrow" data-reveal>What going with your school looks like</p>
          <h2 data-reveal>One flag, four hotels,<br />and a very full two weeks.</h2>
        </div>
        <p class="dek" data-reveal>
          Faculty-led programs are the short, structured way in. You travel as a group,
          the itinerary is built for you, and the academic and the social happen in the
          same fortnight.
        </p>
      </div>

      <div class="mosaic">
        <div class="mosaic__a" data-reveal>
          <Figure src={pYamahaGroup} alt="The Wayne State group holding a university flag in the lobby of the Yamaha Kakegawa piano factory, beside a piano-shaped welcome sign dated June 22, 2026." caption="Yamaha Kakegawa factory, June 22." ratio="16x9" sizes="(min-width: 64rem) 46rem, 92vw" widths={[500, 900, 1400]} />
        </div>
        <div class="mosaic__b" data-reveal data-reveal-delay="60">
          <Figure src={pKyotoGroup} alt="A group selfie of the Wayne State students in front of the main gate at Fushimi Inari shrine in Kyoto, with umbrellas up in the rain." caption="Fushimi Inari, Kyoto." ratio="3x4" sizes="(min-width: 64rem) 22rem, 46vw" widths={[350, 700]} />
        </div>
        <div class="mosaic__c" data-reveal data-reveal-delay="120">
          <Figure src={pOsakaUni} alt="The Wayne State group and Japanese students posed together with a Wayne State flag outside a university building in Osaka." caption="Case study with Japanese students, Osaka." ratio="4x3" sizes="(min-width: 64rem) 22rem, 46vw" widths={[350, 700]} />
        </div>
        <div class="mosaic__d" data-reveal data-reveal-delay="180">
          <Figure src={pTeppan} alt="The group seated around a teppanyaki grill in Hamamatsu while a chef in white cooks in front of them." caption="Team dinner, Hamamatsu." ratio="4x3" sizes="(min-width: 64rem) 22rem, 46vw" widths={[350, 700]} />
        </div>
        <div class="mosaic__e" data-reveal data-reveal-delay="240">
          <Figure src={pMazda} alt="Gotibeh in a Wayne State polo at the Mazda Museum in Hiroshima with the green and orange Mazda 787B Le Mans car behind him." caption="Mazda Museum, Hiroshima." ratio="4x3" sizes="(min-width: 64rem) 22rem, 46vw" widths={[350, 700]} />
        </div>
        <div class="mosaic__f" data-reveal data-reveal-delay="300">
          <Figure src={pRain} alt="Three classmates in clear plastic rain ponchos standing on a wet residential street in Hiroshima at dusk." caption="Hiroshima, in the rain." ratio="4x3" sizes="(min-width: 64rem) 22rem, 46vw" widths={[350, 700]} />
        </div>
      </div>

      <p class="centered" style="margin-top:2.5rem">
        <a class="button button--ghost" href={`${base}the-trip/`}>Walk the whole trip<span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  {/* ================= CHAPTERS ================= */}
  <section class="section section--ruled">
    <div class="wrap">
      <p class="eyebrow" data-reveal>What's inside</p>
      <h2 class="chapters__h" data-reveal>Five things I wish someone<br />had written down for me.</h2>

      <ol class="chapters">
        {chapters.map((c, i) => (
          <li data-reveal data-reveal-delay={i * 60}>
            <a href={`${base}${c.href}`} class="chapter">
              <span class="chapter__n">{c.n}</span>
              <span class="chapter__body">
                <span class="chapter__title">{c.title}</span>
                <span class="chapter__dek">{c.dek}</span>
              </span>
              <span class="chapter__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ================= WHO IT'S FOR ================= */}
  <section class="section section--raised">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow" data-reveal>Who this is for</p>
        <h2 data-reveal>If you have ever closed the tab, this is for you.</h2>
        <p class="dek" data-reveal>
          I wrote it with Wayne State engineering and business students in mind, because
          that is who I am and those are the offices I can name. But the method — take the
          budget apart, separate what follows the trip from what follows the term, ask for
          the review, line up the dates — works at any US university.
        </p>
      </div>
      <div class="grid-3 who-grid" style="grid-template-columns:1fr">
        <div class="card" data-reveal>
          <div class="card__rule"></div>
          <h3>Students</h3>
          <p>Start with <a href={`${base}my-numbers/`}>my numbers</a> to see what a real short program costs, then <a href={`${base}tools/`}>the calculator</a> to work out yours.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="70">
          <div class="card__rule"></div>
          <h3>Advisors and student orgs</h3>
          <p>There is a <a href={`${base}for-advisors/`}>page built for you</a>, with a summary you can forward and a printable handout.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="140">
          <div class="card__rule"></div>
          <h3>Anyone checking my work</h3>
          <p>Every figure, rule and date on this site is listed with its source on the <a href={`${base}sources/`}>sources page</a>.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ================= WHERE NEXT ================= */}
  <section class="section section--ruled" id="next">
    <div class="wrap">
      <div class="next-head">
        <div>
          <p class="eyebrow" data-reveal>Where I go from here</p>
          <h2 data-reveal>Japan was the first one.<br />It is not meant to be the last.</h2>
        </div>
        <p class="dek" data-reveal>
          Two weeks changed what I think is possible. I am working toward a graduate
          program abroad in manufacturing and supply chain, and these are the countries
          I am aiming at. They are plotted on the globe at the top of this page.
        </p>
      </div>

      <div class="dest-grid">
        {REGIONS.map((region, ri) => (
          <div class="dest-group" data-reveal data-reveal-delay={ri * 60}>
            <p class="dest-group__h">{region}</p>
            <ul>
              {DESTINATIONS.filter((d) => d.region === region).map((d) => <li>{d.name}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="callout callout--box dest-note" data-reveal>
        <p>
          <strong>If you fund, host or advise international students,</strong> I would
          like to hear from you. My background is mechanical engineering and global
          supply chain management, and what I want next is to study how electrified,
          automated manufacturing actually works somewhere it is being built.
        </p>
        <p class="cta-row" style="margin-top:1rem">
          <a class="button button--ghost button--sm" href="mailto:alhadygotibeh@gmail.com?subject=Pell%20to%20Planet">Get in touch</a>
          <a class="button button--ghost button--sm" href="https://www.linkedin.com/in/gotibeh/" rel="noopener">LinkedIn</a>
        </p>
      </div>
    </div>
  </section>

  {/* ================= CTA ================= */}
  <section class="section closer">
    <div class="wrap wrap--narrow centered">
      <p class="eyebrow centered" data-reveal>Your turn</p>
      <h2 data-reveal>Find out what your<br />number actually is.</h2>
      <p class="lede centered" data-reveal>
        The calculator asks for the same handful of lines I had to chase down, then shows
        you the gap and when it falls due. Print it and bring it to Financial Aid.
      </p>
      <p class="cta-row centered" style="justify-content:center" data-reveal>
        <a class="button" href={`${base}tools/`}>Open the gap calculator<span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <style>
    /* ---------------- hero ---------------- */
    .hero {
      position: relative;
      min-height: min(100svh, 56rem);
      display: grid;
      align-items: center;
      padding-block: clamp(4rem, 12vh, 8rem) clamp(5rem, 12vh, 7rem);
      overflow: hidden;
      isolation: isolate;
    }
    .hero__bg {
      position: absolute; inset: -20% -10% auto -10%; height: 130%; z-index: -1;
      background:
        radial-gradient(ellipse 60% 50% at 72% 42%, rgb(var(--glow) / 0.16), transparent 70%),
        radial-gradient(ellipse 50% 40% at 18% 20%, rgba(107, 176, 247, 0.10), transparent 70%);
      filter: blur(6px);
    }
    .hero__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; position: relative; z-index: 3; }
    @media (min-width: 62rem) { .hero__grid { grid-template-columns: 1.02fr 0.98fr; } }

    .hero__kicker {
      display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: 1.4rem;
      font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--ink-2); padding: 0.4rem 0.8rem; border: 1px solid var(--hairline);
      border-radius: 999px; background: color-mix(in oklab, var(--surface-1) 70%, transparent);
    }
    .hero__kicker .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--torii); flex: none; box-shadow: 0 0 0 0 rgb(var(--glow) / 0.6); animation: ping 2.6s ease-out infinite; }
    @keyframes ping { 0% { box-shadow: 0 0 0 0 rgb(var(--glow) / 0.55); } 70%, 100% { box-shadow: 0 0 0 9px rgb(var(--glow) / 0); } }

    .hero h1 { margin-bottom: 1.15rem; }
    .hero h1 span { display: block; }
    .hero h1 .l2 em { color: var(--torii); }
    .hero .lede { margin-bottom: 2rem; }
    .hero__byline {
      margin-top: 2.25rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em;
      color: var(--ink-3); text-transform: uppercase;
    }
    .hero__globe { position: relative; }
    @media (max-width: 61.99rem) {
      .hero__globe { order: -1; max-width: 26rem; margin-inline: auto; width: 100%; opacity: 0.95; }
    }

    .scroll-cue {
      position: absolute; left: 50%; bottom: 1.75rem; translate: -50% 0; z-index: 4;
      display: grid; justify-items: center; gap: 0.5rem; text-decoration: none;
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--ink-3);
    }
    .scroll-cue:hover { color: var(--torii); }
    .scroll-cue i { display: block; width: 1px; height: 2.2rem; background: linear-gradient(var(--ink-3), transparent); }
    @media (prefers-reduced-motion: no-preference) {
      .scroll-cue i { animation: cue 2.4s ease-in-out infinite; transform-origin: top; }
      @keyframes cue { 0%, 100% { transform: scaleY(0.35); opacity: 0.4; } 50% { transform: scaleY(1); opacity: 1; } }
    }
    @media (max-width: 61.99rem) { .scroll-cue { display: none; } }

    /* ---------------- stat strip ---------------- */
    .stat-strip { display: grid; gap: 2.5rem; }
    @media (min-width: 60rem) { .stat-strip { grid-template-columns: 1fr 1.5fr; align-items: center; gap: 3.5rem; } }
    .stat--lead .stat__value--hero { font-size: clamp(3rem, 7vw, 4.75rem); color: var(--torii); letter-spacing: -0.04em; }
    .stat--lead .stat__label { order: -1; margin-bottom: 0.4rem; }
    .stat--lead .stat__sub { max-width: 30ch; margin-top: 0.4rem; }
    .stat-strip__rest { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1.5rem; }
    @media (min-width: 48rem) { .stat-strip__rest { grid-template-columns: repeat(4, 1fr); } }
    .stat-strip__rest .stat { border-top: 1px solid var(--hairline-2); padding-top: 0.85rem; }
    .stat-strip__rest .stat__value { font-size: clamp(1.7rem, 3vw, 2.2rem); }
    .stat-strip__note { margin: 2.5rem 0 0; color: var(--ink-2); }

    /* ---------------- torii ---------------- */
    .torii-section {
      position: relative; overflow: hidden;
      padding-block: clamp(7rem, 22vh, 13rem);
      min-height: min(78svh, 46rem);
      background: linear-gradient(180deg, var(--void), color-mix(in oklab, var(--torii) 5%, var(--void)) 50%, var(--void));
      border-block: 1px solid var(--hairline);
    }
    /* A scrim between the gates and the copy. Without it the tunnel wins and
       the words become decoration. */
    .torii-section::after {
      content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background: radial-gradient(ellipse 40% 24% at 50% 48%, color-mix(in oklab, var(--void) 58%, transparent) 0%, color-mix(in oklab, var(--void) 22%, transparent) 62%, transparent 88%);
    }
    .torii-section__inner { position: relative; z-index: 2; text-align: center; max-width: 52rem; }
    .torii-section__h { font-size: clamp(2.2rem, 6vw, 4.2rem); margin-bottom: 1.5rem; text-shadow: 0 2px 24px var(--void), 0 1px 4px var(--void); }
    .torii-section .lede, .torii-section .eyebrow { text-shadow: 0 1px 14px var(--void), 0 1px 3px var(--void); }
    .torii-section .lede { margin-inline: auto; max-width: 44ch; }

    /* ---------------- mosaic ---------------- */
    .mosaic-head { display: grid; gap: 1.5rem; margin-bottom: 2.75rem; }
    @media (min-width: 56rem) { .mosaic-head { grid-template-columns: 1.3fr 1fr; align-items: end; gap: 3rem; } }
    .mosaic { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 56rem) { .mosaic { grid-template-columns: repeat(4, 1fr); gap: 1.15rem; } }
    .mosaic__a { grid-column: span 2; }
    @media (min-width: 56rem) { .mosaic__a { grid-column: span 3; } .mosaic__b { grid-column: span 1; } }

    /* ---------------- chapters ---------------- */
    .chapters__h { margin-bottom: 2.5rem; }
    .chapters { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
    .chapters li { margin: 0; max-width: none; }
    .chapter {
      display: grid; grid-template-columns: auto 1fr auto; gap: 1rem 1.5rem; align-items: baseline;
      padding: 1.6rem 0.5rem 1.6rem 0; border-bottom: 1px solid var(--hairline); text-decoration: none;
      transition: background 0.3s, padding 0.3s;
    }
    @media (min-width: 48rem) { .chapter { gap: 1rem 2.5rem; } }
    .chapter:hover { background: linear-gradient(90deg, color-mix(in oklab, var(--torii) 7%, transparent), transparent 70%); padding-left: 0.85rem; color: inherit; }
    .chapter__n { font-family: var(--mono); font-size: 0.72rem; color: var(--torii); letter-spacing: 0.06em; padding-top: 0.35rem; }
    .chapter__title { display: block; font-family: var(--serif); font-size: clamp(1.6rem, 3.4vw, 2.3rem); line-height: 1.1; margin-bottom: 0.35rem; }
    .chapter__dek { display: block; color: var(--ink-2); font-size: 0.95rem; max-width: 56ch; }
    .chapter__arrow { color: var(--ink-3); font-size: 1.1rem; transition: transform 0.25s, color 0.25s; }
    .chapter:hover .chapter__arrow { transform: translateX(5px); color: var(--torii); }
    @media (max-width: 34rem) {
      .chapter { grid-template-columns: auto 1fr; }
      .chapter__arrow { display: none; }
    }

    .who-grid { gap: 1rem; }

    .next-head { display: grid; gap: 1.25rem; margin-bottom: 2.5rem; }
    @media (min-width: 56rem) { .next-head { grid-template-columns: 1.15fr 1fr; align-items: end; gap: 3rem; } }
    .dest-grid { display: grid; gap: 1.75rem 2rem; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 56rem) { .dest-grid { grid-template-columns: repeat(4, 1fr); } }
    .dest-group__h { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--torii); margin-bottom: 0.75rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--hairline); }
    .dest-group ul { list-style: none; padding: 0; margin: 0; }
    .dest-group li { font-size: 0.95rem; color: var(--ink-2); margin-bottom: 0.4rem; }
    .dest-note { margin-top: 2.5rem; max-width: 46rem; }
    .closer { text-align: center; }
    .closer h2 { font-size: clamp(2.1rem, 5.5vw, 3.6rem); }
  </style>
</Base>
